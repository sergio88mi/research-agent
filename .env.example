# Copy this file to .env and fill in the values. .env is git-ignored.
# Only GEMINI_API_KEY is required. Leave an optional line empty rather than typing placeholder text into it:
# whatever is there is sent with the requests.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: a contact email, sent with OpenAlex and Crossref requests as those services ask
OPENALEX_EMAIL=
# Optional but worth having: a free OpenAlex key (openalex.org/settings/api) raises the daily search budget tenfold (remediation #10)
OPENALEX_API_KEY=
# Stage 7 - literature sources searched for every sub-question, in order (automatic failover between them)
SOURCES=openalex,semanticscholar
# Optional Semantic Scholar key (www.semanticscholar.org/product/api#api-key-form): a dedicated 1 request/second instead of the shared public pool
S2_API_KEY=
# Optional, normally left out: the Semantic Scholar search address. Pointing it at a path that does not exist
# makes that source fail, which is how the failover was demonstrated (functional test FT-11).
# S2_ENDPOINT=https://api.semanticscholar.org/graph/v1/paper/search
