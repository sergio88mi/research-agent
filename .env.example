# Copy this file to .env and fill in the values. .env is git-ignored.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
# OpenAlex asks for a contact email in requests ("polite pool") - faster, more reliable responses
OPENALEX_EMAIL=you@example.com
OPENALEX_API_KEY=your-free-openalex-key-from-openalex.org/settings/api
# Stage 7 - literature sources searched for every sub-question, in order (automatic failover between them)
SOURCES=openalex,semanticscholar
# Optional Semantic Scholar key (api.semanticscholar.org/product/api#api-key): a dedicated 1 request/second instead of the shared public pool
S2_API_KEY=
